---
// src/pages/parser.astro
import "../styles/global.css";
import "../styles/style.css";
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>GlossAI - Parser</title>
    </head>

    <body class="bg-gray-50">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 px-8 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <a href="/" class="text-gray-600 hover:text-gray-900">
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <img
                        src="static/logo.png"
                        alt="GlossAI Logo"
                        width="200px"
                    />
                </div>
                <div class="flex gap-3">
                    <button
                        id="backBtn"
                        class="bg-primary hover-bg-primary text-white px-6 py-2 rounded-lg font-medium transition-colors"
                    >
                        Back to Glossary
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="px-8 py-8">
            <div class="max-w-7xl mx-auto">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-semibold text-gray-900">
                        Code Parser
                    </h2>
                </div>

                <div class="mb-8">
                    <p class="text-gray-600">
                        Analyze files to extract class names, methods,
                        variables, and other identifiers.
                    </p>
                </div>

                <!-- Upload/Select Section -->
                <div
                    class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 mb-8"
                >
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        Select Source
                    </h3>

                    <div class="flex gap-4 mb-6">
                        <button
                            id="selectFileBtn"
                            class="flex-1 flex flex-col items-center justify-center p-6 border-2 border-dashed border-gray-300 rounded-lg hover:border-primary hover:bg-blue-50 transition-colors"
                        >
                            <svg
                                class="w-12 h-12 text-gray-400 mb-3"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                ></path>
                            </svg>
                            <span class="text-gray-700 font-medium"
                                >Analyze Single File</span
                            >
                            <span class="text-sm text-gray-500 mt-1"
                                >.java, .py, .rs, .js, .jsx, .php files</span
                            >
                        </button>

                        <button
                            id="selectFolderBtn"
                            class="flex-1 flex flex-col items-center justify-center p-6 border-2 border-dashed border-gray-300 rounded-lg hover:border-primary hover:bg-blue-50 transition-colors"
                        >
                            <svg
                                class="w-12 h-12 text-gray-400 mb-3"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                                ></path>
                            </svg>
                            <span class="text-gray-700 font-medium"
                                >Analyze Folder</span
                            >
                            <span class="text-sm text-gray-500 mt-1"
                                >Recursive file analysis</span
                            >
                        </button>
                    </div>

                    <!-- Selected Path Display -->
                    <div
                        id="selectedPathContainer"
                        class="hidden mb-4 p-4 bg-gray-50 rounded-lg"
                    >
                        <div class="flex justify-between items-center">
                            <div>
                                <p class="text-sm text-gray-600">Selected:</p>
                                <p
                                    id="selectedPath"
                                    class="text-gray-900 font-medium"
                                >
                                </p>
                            </div>
                            <button
                                id="clearSelectionBtn"
                                class="text-gray-500 hover:text-gray-700"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Analyze Button -->
                    <button
                        id="analyzeBtn"
                        disabled
                        class="w-full bg-primary hover-bg-primary text-white py-3 rounded-lg font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Analyze Code
                    </button>
                </div>

                <!-- Results Section -->
                <div id="resultsContainer" class="hidden">
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
                        <!-- Results Header -->
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-lg font-semibold text-gray-900">
                                Analysis Results
                            </h3>
                        </div>

                        <!-- Summary Stats -->
                        <div id="summaryStats" class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                            <!-- Stats will be populated here -->
                        </div>

                        <!-- Results Content with Sidebar Layout -->
                        <div class="flex flex-col lg:flex-row gap-6 justify-center">
                            <!-- Left Column - Table -->
                            <div id="tableColumn" class="w-full lg:w-2/3 transition-all duration-300">
                                <!-- All Identifiers View -->
                                <div id="allIdentifiersView">
                                    <div class="overflow-x-auto">
                                        <table class="w-full">
                                            <thead class="bg-gray-50">
                                                <tr>
                                                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">
                                                        <button class="sort-btn flex items-center gap-1" data-sort="identifier" data-direction="asc">
                                                            Identifier
                                                            <span class="sort-indicator">
                                                                <svg class="w-4 h-4 opacity-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                                                </svg>
                                                            </span>
                                                        </button>
                                                    </th>
                                                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">
                                                        <button class="sort-btn flex items-center gap-1" data-sort="occurrences" data-direction="asc">
                                                            Occurrences
                                                            <span class="sort-indicator">
                                                                <svg class="w-4 h-4 opacity-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                                                </svg>
                                                            </span>
                                                        </button>
                                                    </th>
                                                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">
                                                        <button class="sort-btn flex items-center gap-1" data-sort="status" data-direction="asc">
                                                            Status
                                                            <span class="sort-indicator">
                                                                <svg class="w-4 h-4 opacity-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                                                </svg>
                                                            </span>
                                                        </button>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody
                                                id="identifiersTable"
                                                class="divide-y divide-gray-200"
                                            >
                                                <!-- Will be populated with JavaScript -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- By File View (Hidden) -->
                                <div id="byFileView" class="hidden">
                                    <div id="filesList" class="space-y-4">
                                        <!-- Will be populated with JavaScript -->
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column - Metrics and Chart (Visible by default) -->
                            <div id="chartColumn" class="lg:w-96">
                                <!-- UL Coverage Metric Card -->
                                <div id="ulCoverageCard" class="bg-white rounded-lg border border-gray-200 p-6 mb-4 shadow-sm">
                                    <div class="flex items-center justify-between mb-2">
                                        <h4 class="text-sm font-medium text-gray-600">UL Coverage</h4>
                                        <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                        </svg>
                                    </div>
                                    <div class="flex items-baseline gap-2">
                                        <span id="ulCoverageValue" class="text-3xl font-bold text-gray-900">0%</span>
                                        <span class="text-sm text-gray-500">of terms in glossary</span>
                                    </div>
                                    <div class="mt-3">
                                        <div class="flex justify-between text-xs text-gray-600 mb-1">
                                            <span id="ulCoverageStats">0 out of 0 terms</span>
                                        </div>
                                        <div class="w-full bg-gray-200 rounded-full h-2">
                                            <div id="ulCoverageBar" class="bg-blue-500 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- UL Alignment Metric Card -->
                                <div id="ulAlignmentCard" class="bg-white rounded-lg border border-gray-200 p-6 mb-4 shadow-sm">
                                    <div class="flex items-center justify-between mb-2">
                                        <h4 class="text-sm font-medium text-gray-600">UL Alignment</h4>
                                        <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                    <div class="flex items-baseline gap-2">
                                        <span id="ulAlignmentValue" class="text-3xl font-bold text-gray-900">0%</span>
                                        <span class="text-sm text-gray-500">alignment score</span>
                                    </div>
                                    <div class="mt-3">
                                        <div class="flex justify-between text-xs text-gray-600 mb-1">
                                            <span id="ulAlignmentStats">0 out of 0 total occurrences</span>
                                        </div>
                                        <div class="w-full bg-gray-200 rounded-full h-2">
                                            <div id="ulAlignmentBar" class="bg-purple-500 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Chart Card -->
                                <div class="bg-gray-50 rounded-lg border border-gray-200 p-6 h-full">
                                    <!-- Chart Header -->
                                    <div class="mb-6">
                                        <h4 class="text-lg font-semibold text-gray-900">Term Distribution</h4>
                                        <p id="selectedTermName" class="text-sm text-gray-600 mt-1"></p>
                                    </div>

                                    <!-- Chart Container -->
                                    <div id="pieChartContainer" style="height: 350px;">
                                        <!-- Placeholder when no chart is displayed -->
                                        <div class="flex items-center justify-center h-full">
                                            <div class="text-center">
                                                <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
                                                </svg>
                                                <p class="text-gray-500 font-medium">Select a term to view distribution</p>
                                                <p class="text-sm text-gray-400 mt-2">Click on any row in the table</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Chart Legend -->
                                    <div id="chartLegend" class="mt-6 space-y-2 max-h-60 overflow-y-auto pr-2">
                                        <!-- Legend items will be populated here -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loading State -->
                <div id="loadingContainer" class="hidden">
                    <div
                        class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center"
                    >
                        <div
                            class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary"
                        >
                        </div>
                        <p class="mt-4 text-gray-600">Analyzing code...</p>
                        <p id="loadingDetails" class="text-sm text-gray-500">
                        </p>
                    </div>
                </div>

                <!-- Error State -->
                <div id="errorContainer" class="hidden">
                    <div class="bg-red-50 border border-red-200 rounded-lg p-6">
                        <div class="flex items-center">
                            <svg
                                class="w-6 h-6 text-red-600 mr-3"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                            <h3 class="text-lg font-semibold text-red-800">
                                Analysis Error
                            </h3>
                        </div>
                        <p id="errorMessage" class="mt-2 text-red-700"></p>
                    </div>
                </div>
            </div>
        </main>

        <script>
            import CanvasJS from '@canvasjs/charts';
            // ===== VARIABLES GLOBALES =====
            const urlParams = new URLSearchParams(window.location.search);
            const glossaryId = urlParams.get("id");
            let selectedPath = null;
            let isFile = true;
            let analysisResults = null;
            let currentGlossary = null;
            let currentSort = { column: 'occurrences', direction: 'desc' };
            let identifiersData = [];

            // ===== ÉLÉMENTS DU DOM =====
            const backBtn = document.getElementById("backBtn");
            const selectFileBtn = document.getElementById("selectFileBtn");
            const selectFolderBtn = document.getElementById("selectFolderBtn");
            const selectedPathContainer = document.getElementById(
                "selectedPathContainer",
            );
            const selectedPathElement = document.getElementById("selectedPath");
            const clearSelectionBtn =
                document.getElementById("clearSelectionBtn");
            const analyzeBtn = document.getElementById("analyzeBtn");
            const resultsContainer =
                document.getElementById("resultsContainer");
            const loadingContainer =
                document.getElementById("loadingContainer");
            const errorContainer = document.getElementById("errorContainer");
            const errorMessage = document.getElementById("errorMessage");
            const loadingDetails = document.getElementById("loadingDetails");
            const identifiersTable =
                document.getElementById("identifiersTable");
            const summaryStats = document.getElementById("summaryStats");

            // ===== FONCTIONS UTILITAIRES =====
            function updateBackButton() {
                if (glossaryId) {
                    backBtn.onclick = () => {
                        window.location.href = `/glossary?id=${glossaryId}`;
                    };
                } else {
                    backBtn.onclick = () => {
                        window.location.href = "/";
                    };
                }
            }

            function showError(message) {
                errorMessage.textContent = message;
                errorContainer.classList.remove("hidden");
                loadingContainer.classList.add("hidden");
                resultsContainer.classList.add("hidden");
            }

            function clearError() {
                errorContainer.classList.add("hidden");
            }

            function showLoading(message = "Analyzing code...") {
                loadingDetails.textContent = message;
                loadingContainer.classList.remove("hidden");
                errorContainer.classList.add("hidden");
                resultsContainer.classList.add("hidden");
            }

            function hideLoading() {
                loadingContainer.classList.add("hidden");
            }

            // ===== GESTION DE LA SÉLECTION =====
            async function selectFile() {
                try {
                    const { open } = window.__TAURI__.dialog;
                    const selected = await open({
                        filters: [
                            {
                                name: "Fichiers de code",
                                extensions: ["java", "py", "rs", "js", "jsx", "php"],
                            },
                        ],
                    });

                    if (selected) {
                        selectedPath = selected;
                        isFile = true;
                        updateSelectionDisplay();
                    }
                } catch (error) {
                    showError(
                        `Error selecting file: ${error.message || error}`,
                    );
                }
            }

            async function selectFolder() {
                try {
                    const { open } = window.__TAURI__.dialog;
                    const selected = await open({
                        directory: true,
                    });

                    if (selected) {
                        selectedPath = selected;
                        isFile = false;
                        updateSelectionDisplay();
                    }
                } catch (error) {
                    showError(
                        `Error selecting folder: ${error.message || error}`,
                    );
                }
            }

            function updateSelectionDisplay() {
                if (selectedPath) {
                    selectedPathElement.innerHTML = `<strong>${selectedPath}</strong>`;
                    selectedPathContainer.classList.remove("hidden");
                    analyzeBtn.disabled = false;
                    analyzeBtn.classList.remove(
                        "disabled:opacity-50",
                        "disabled:cursor-not-allowed",
                    );
                } else {
                    selectedPathContainer.classList.add("hidden");
                    analyzeBtn.disabled = true;
                    analyzeBtn.classList.add(
                        "disabled:opacity-50",
                        "disabled:cursor-not-allowed",
                    );
                }
            }

            function clearSelection() {
                selectedPath = null;
                updateSelectionDisplay();
                clearError();
                resultsContainer.classList.add("hidden");
            }

            // ===== CHARGEMENT DU GLOSSAIRE =====
            function loadGlossary() {
                if (!glossaryId) {
                    currentGlossary = null;
                    return;
                }

                try {
                    const glossaries = JSON.parse(localStorage.getItem("glossaries")) || [];
                    currentGlossary = glossaries.find(g => g.id === parseInt(glossaryId)) || null;
                } catch (error) {
                    console.error("Error loading glossary:", error);
                    currentGlossary = null;
                }
            }

            function isTermInGlossary(term) {
                if (!currentGlossary || !currentGlossary.terms) return false;
                
                return currentGlossary.terms.some(t => 
                    t.term.toLowerCase() === term.toLowerCase()
                );
            }

            // ===== CALCUL DU UL COVERAGE =====
            function calculateULCoverage() {
                if (!analysisResults || !analysisResults.names) return { percentage: 0, inGlossary: 0, total: 0 };
                
                const uniqueTerms = Object.keys(analysisResults.names);
                const total = uniqueTerms.length;
                const inGlossary = uniqueTerms.filter(term => isTermInGlossary(term)).length;
                const percentage = total > 0 ? ((inGlossary / total) * 100).toFixed(1) : 0;
                
                return { percentage, inGlossary, total };
            }

            function updateULCoverage() {
                const { percentage, inGlossary, total } = calculateULCoverage();
                
                // Mettre à jour le pourcentage
                document.getElementById('ulCoverageValue').textContent = `${percentage}%`;
                
                // Mettre à jour les stats
                document.getElementById('ulCoverageStats').textContent = `${inGlossary} out of ${total} terms`;
                
                // Mettre à jour la barre de progression
                document.getElementById('ulCoverageBar').style.width = `${percentage}%`;
                
                // Changer la couleur de la barre en fonction du pourcentage
                const bar = document.getElementById('ulCoverageBar');
                if (percentage >= 75) {
                    bar.className = 'bg-green-500 h-2 rounded-full transition-all duration-500';
                } else if (percentage >= 50) {
                    bar.className = 'bg-yellow-500 h-2 rounded-full transition-all duration-500';
                } else if (percentage >= 25) {
                    bar.className = 'bg-orange-500 h-2 rounded-full transition-all duration-500';
                } else {
                    bar.className = 'bg-red-500 h-2 rounded-full transition-all duration-500';
                }
            }

            // ===== CALCUL DU UL ALIGNMENT =====
            function calculateULAlignment() {
                if (!analysisResults || !analysisResults.names) return { percentage: 0, ulOccurrences: 0, totalOccurrences: 0 };
                
                let ulOccurrences = 0;
                let totalOccurrences = 0;
                
                // Parcourir tous les termes et leurs occurrences
                for (const [term, count] of Object.entries(analysisResults.names)) {
                    totalOccurrences += count;
                    
                    // Si le terme est dans le glossaire, ajouter ses occurrences au compte UL
                    if (isTermInGlossary(term)) {
                        ulOccurrences += count;
                    }
                }
                
                const percentage = totalOccurrences > 0 ? ((ulOccurrences / totalOccurrences) * 100).toFixed(1) : 0;
                
                return { percentage, ulOccurrences, totalOccurrences };
            }

            function updateULAlignment() {
                const { percentage, ulOccurrences, totalOccurrences } = calculateULAlignment();
                
                // Mettre à jour le pourcentage
                document.getElementById('ulAlignmentValue').textContent = `${percentage}%`;
                
                // Mettre à jour les stats
                document.getElementById('ulAlignmentStats').textContent = `${ulOccurrences} out of ${totalOccurrences} total occurrences`;
                
                // Mettre à jour la barre de progression
                document.getElementById('ulAlignmentBar').style.width = `${percentage}%`;
                
                // Changer la couleur de la barre en fonction du pourcentage
                const bar = document.getElementById('ulAlignmentBar');
                if (percentage >= 75) {
                    bar.className = 'bg-green-500 h-2 rounded-full transition-all duration-500';
                } else if (percentage >= 50) {
                    bar.className = 'bg-yellow-500 h-2 rounded-full transition-all duration-500';
                } else if (percentage >= 25) {
                    bar.className = 'bg-orange-500 h-2 rounded-full transition-all duration-500';
                } else {
                    bar.className = 'bg-red-500 h-2 rounded-full transition-all duration-500';
                }
            }

            // ===== ANALYSE =====
            async function analyze() {
                if (!selectedPath) return;

                loadGlossary();

                clearError();
                showLoading(
                    isFile
                        ? `Analyzing file: ${selectedPath.split("/").pop()}`
                        : `Analyzing folder: ${selectedPath.split("/").pop()}`,
                );

                try {
                    const { invoke } = window.__TAURI__.core;

                    if (isFile) {
                        analysisResults = await invoke("analyze_file", {
                            path: selectedPath,
                        });
                    } else {
                        analysisResults = await invoke("analyze_folder", {
                            path: selectedPath,
                        });
                    }

                    hideLoading();
                    displayResults();
                } catch (error) {
                    showError(`Analysis failed: ${error.message || error}`);
                }
            }

            // ===== AFFICHAGE DES RÉSULTATS =====
            function displayResults() {
                if (!analysisResults) return;

                updateSummaryStats();
                displayAllIdentifiers();
                updateULCoverage();
                updateULAlignment();
                resultsContainer.classList.remove("hidden");
            }

            function updateSummaryStats() {
                if (isFile) {
                    const total = Object.values(analysisResults.names).reduce(
                        (a, b) => a + b,
                        0,
                    );
                    const fileName = selectedPath ? selectedPath.split("/").pop() : "File";

                    summaryStats.innerHTML = `
                        <div class="bg-blue-50 p-4 rounded-lg">
                            <p class="text-sm text-blue-600">Total Occurrences</p>
                            <p class="text-2xl font-semibold text-blue-900">${total}</p>
                        </div>
                        <div class="bg-green-50 p-4 rounded-lg">
                            <p class="text-sm text-green-600">Files Parsed</p>
                            <p class="text-2xl font-semibold text-green-900">1</p>
                        </div>
                        <div class="bg-purple-50 p-4 rounded-lg">
                            <p class="text-sm text-purple-600">File Name</p>
                            <p class="text-2xl font-semibold text-purple-900 truncate" title="${fileName}">${fileName}</p>
                        </div>
                    `;
                } else {
                    const totalOccurrences = Object.values(
                        analysisResults.names,
                    ).reduce((a, b) => a + b, 0);
                    const fileCount = Object.keys(analysisResults.files).length;
                    const folderName = selectedPath ? selectedPath.split("/").pop() : "Folder";

                    summaryStats.innerHTML = `
                        <div class="bg-blue-50 p-4 rounded-lg">
                            <p class="text-sm text-blue-600">Total Occurrences</p>
                            <p class="text-2xl font-semibold text-blue-900">${totalOccurrences}</p>
                        </div>
                        <div class="bg-green-50 p-4 rounded-lg">
                            <p class="text-sm text-green-600">Files Parsed</p>
                            <p class="text-2xl font-semibold text-green-900">${fileCount}</p>
                        </div>
                        <div class="bg-purple-50 p-4 rounded-lg">
                            <p class="text-sm text-purple-600">Folder Name</p>
                            <p class="text-2xl font-semibold text-purple-900 truncate" title="${folderName}">${folderName}</p>
                        </div>
                    `;
                }
            }

            function displayAllIdentifiers() {
                const names = analysisResults.names;
                
                identifiersData = Object.entries(names).map(([name, count]) => ({
                    name,
                    count,
                    inGlossary: isTermInGlossary(name)
                }));
                
                // Réinitialiser le tri par défaut
                currentSort = { column: 'occurrences', direction: 'desc' };
                updateSortIndicators();
                renderTable();
            }

            function renderTable() {
                if (!identifiersData || identifiersData.length === 0) return;
                
                const { column, direction } = currentSort;
                
                // Trier les données
                const sortedData = [...identifiersData].sort((a, b) => {
                    let comparison = 0;
                    
                    switch (column) {
                        case 'identifier':
                            comparison = a.name.localeCompare(b.name);
                            break;
                        case 'occurrences':
                            comparison = a.count - b.count;
                            break;
                        case 'status':
                            if (a.inGlossary !== b.inGlossary) {
                                comparison = a.inGlossary ? -1 : 1;
                            } else {
                                comparison = a.name.localeCompare(b.name);
                            }
                            break;
                    }
                    
                    return direction === 'asc' ? comparison : -comparison;
                });
                
                identifiersTable.innerHTML = sortedData
                    .map(({ name, count, inGlossary }) => {
                        // Déterminer la couleur de la ligne en fonction de la présence dans le glossaire
                        let rowColorClass;
                        if (inGlossary) {
                            rowColorClass = 'bg-green-50 hover:bg-green-100 cursor-pointer';
                        } else {
                            rowColorClass = 'bg-red-50 hover:bg-red-100 cursor-pointer';
                        }
                        
                        return `
                            <tr class="${rowColorClass} term-row" data-term="${name}">
                                <td class="px-6 py-4 font-bold">
                                    <span class="font-mono text-sm bg-white px-2 py-1 rounded border">${name}</span>
                                </td>
                                <td class="px-6 py-4 font-bold">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm">
                                        ${count} occurrence${count > 1 ? "s" : ""}
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-bold">
                                    ${inGlossary ? 
                                        `<span class="text-green-600 text-sm font-medium flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                            </svg>
                                            Already in glossary
                                        </span>` : 
                                        glossaryId ? 
                                        `<button class="text-blue-600 hover:text-blue-900 text-sm font-medium add-identifier" data-identifier="${name}">
                                            Add to Glossary
                                        </button>` :
                                        `<span class="text-gray-500 text-sm">Select a glossary to add</span>`
                                    }
                                </td>
                            </tr>
                        `;
                    })
                    .join("");
                
                // Réattacher les écouteurs d'événements
                document.querySelectorAll(".term-row").forEach((row) => {
                    row.addEventListener("click", function (event) {
                        // Ne pas déclencher si on clique sur le bouton "Add to Glossary"
                        if (!event.target.closest('.add-identifier')) {
                            const term = this.getAttribute("data-term");
                            showTermDistribution(term);
                        }
                    });
                });
                
                document.querySelectorAll(".add-identifier").forEach((btn) => {
                    btn.addEventListener("click", function (event) {
                        event.stopPropagation();
                        const identifier = this.getAttribute("data-identifier");
                        addIdentifierToGlossary(identifier);
                    });
                });
            }

            function showTermDistribution(term) {
                // Mettre à jour le nom du terme sélectionné
                document.getElementById("selectedTermName").textContent = term;
                
                // Palette de couleurs pour le graphique
                const colors = [
                    '#4F46E5', '#7C3AED', '#EC4899', '#F59E0B', '#10B981',
                    '#3B82F6', '#8B5CF6', '#EF4444', '#F97316', '#14B8A6'
                ];
                
                // Préparer les données pour le camembert
                const fileData = [];
                let totalOccurrences = 0;
                
                // Vérifier si on a des données de fichiers pour ce terme
                if (!analysisResults.files || Object.keys(analysisResults.files).length === 0) {
                    // Pas de données de fichiers, afficher un message
                    document.getElementById("pieChartContainer").innerHTML = `
                        <div class="flex items-center justify-center h-full">
                            <div class="text-center">
                                <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <p class="text-gray-500 font-medium">No file distribution data available</p>
                                <p class="text-sm text-gray-400 mt-2">Single file analysis only shows total occurrences.</p>
                            </div>
                        </div>
                    `;
                    document.getElementById("chartLegend").innerHTML = '';
                    return;
                }
                
                // Parcourir TOUS les fichiers pour trouver ce terme
                for (const [fileName, fileInfo] of Object.entries(analysisResults.files)) {
                    // Vérifier que fileInfo.names existe et contient le terme
                    if (fileInfo && fileInfo.names && fileInfo.names.hasOwnProperty(term)) {
                        const occurrences = fileInfo.names[term];
                        
                        // Ne garder que les fichiers avec au moins 1 occurrence
                        if (occurrences > 0) {
                            totalOccurrences += occurrences;
                            
                            // Gérer les chemins Windows et Unix
                            const pathParts = fileName.split(/[/\\]/);
                            const shortName = pathParts[pathParts.length - 1] || fileName;
                            
                            fileData.push({
                                name: shortName,
                                fullPath: fileName,
                                occurrences: occurrences,
                                y: occurrences
                            });
                        }
                    }
                }
                
                // Log de débogage pour voir combien de fichiers ont été trouvés
                console.log(`Term "${term}" found in ${fileData.length} files with ${totalOccurrences} total occurrences:`, fileData);
                
                // Vérifier si plus d'un fichier contient ce terme
                if (fileData.length === 0) {
                    // Aucun fichier trouvé
                    document.getElementById("pieChartContainer").innerHTML = `
                        <div class="flex items-center justify-center h-full">
                            <div class="text-center">
                                <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <p class="text-gray-500 font-medium">No occurrences found for this term</p>
                                <p class="text-sm text-gray-400 mt-2">This term may not exist in the analyzed files.</p>
                            </div>
                        </div>
                    `;
                    document.getElementById("chartLegend").innerHTML = '';
                    return;
                } else if (fileData.length === 1) {
                    // Un seul fichier
                    document.getElementById("pieChartContainer").innerHTML = `
                        <div class="flex items-center justify-center h-full">
                            <div class="text-center">
                                <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <p class="text-gray-500 font-medium">Term found in 1 file only</p>
                                <p class="text-sm text-gray-400 mt-2">Pie chart requires distribution across multiple files.</p>
                                <p class="text-sm font-medium text-gray-600 mt-4">${fileData[0].name}: ${fileData[0].occurrences} occurrence${fileData[0].occurrences > 1 ? 's' : ''}</p>
                            </div>
                        </div>
                    `;
                    document.getElementById("chartLegend").innerHTML = '';
                    return;
                }
                
                // Trier par nombre d'occurrences décroissant
                fileData.sort((a, b) => b.occurrences - a.occurrences);
                
                // Créer le graphique avec les couleurs correspondantes
                const chart = new CanvasJS.Chart("pieChartContainer", {
                    animationEnabled: true,
                    title: {
                        text: `Distribution: ${totalOccurrences} total`,
                        fontSize: 16,
                        fontFamily: "Inter, sans-serif",
                        fontWeight: "normal"
                    },
                    data: [{
                        type: "pie",
                        startAngle: 240,
                        indexLabel: null,
                        showInLegend: false,
                        toolTipContent: "<b>{name}</b>: {y} occurrences",
                        dataPoints: fileData.map((item, index) => ({
                            name: item.name,
                            y: item.occurrences,
                            color: colors[index % colors.length]
                        }))
                    }]
                });
                
                chart.render();
                
                // Mettre à jour la légende
                updateChartLegend(fileData);
                
                // Scroll vers le chart
                const chartColumn = document.getElementById("chartColumn");
                chartColumn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            function updateChartLegend(fileData) {
                const legendContainer = document.getElementById("chartLegend");
                
                if (fileData.length === 0) {
                    legendContainer.innerHTML = `
                        <div class="text-center py-4 text-gray-500">
                            <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            <p class="mt-2">No file data available</p>
                        </div>
                    `;
                    return;
                }
                
                // Palette de couleurs pour le graphique
                const colors = [
                    '#4F46E5', '#7C3AED', '#EC4899', '#F59E0B', '#10B981',
                    '#3B82F6', '#8B5CF6', '#EF4444', '#F97316', '#14B8A6'
                ];
                
                legendContainer.innerHTML = fileData.map((item, index) => {
                    const percentage = ((item.occurrences / fileData.reduce((sum, f) => sum + f.occurrences, 0)) * 100).toFixed(1);
                    const color = colors[index % colors.length];
                    
                    return `
                        <div class="flex items-center justify-between p-3 bg-white rounded-lg border border-gray-200 hover:bg-gray-50">
                            <div class="flex items-center gap-3 min-w-0 flex-1">
                                <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: ${color};"></div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium text-gray-900 truncate" title="${item.fullPath}">
                                        ${item.name}
                                    </p>
                                    <p class="text-xs text-gray-500 truncate" title="${item.fullPath}">
                                        ${item.fullPath}
                                    </p>
                                </div>
                            </div>
                            <div class="text-right ml-2 flex-shrink-0">
                                <span class="text-sm font-semibold text-gray-900">${item.occurrences}</span>
                                <span class="text-xs text-gray-500"> (${percentage}%)</span>
                            </div>
                        </div>
                    `;
                }).join("");
            }

            function updateSortIndicators() {
                document.querySelectorAll('.sort-btn').forEach(btn => {
                    const indicator = btn.querySelector('.sort-indicator svg');
                    const column = btn.getAttribute('data-sort');
                    
                    if (column === currentSort.column) {
                        indicator.classList.remove('opacity-0');
                        indicator.classList.add('opacity-100', 'transition-transform', 'duration-200');
                        // Mettre à jour la direction de la flèche
                        if (currentSort.direction === 'asc') {
                            indicator.style.transform = 'rotate(0deg)';
                        } else {
                            indicator.style.transform = 'rotate(180deg)';
                        }
                    } else {
                        indicator.classList.remove('opacity-100', 'transition-transform');
                        indicator.classList.add('opacity-0');
                        indicator.style.transform = 'rotate(0deg)';
                    }
                });
            }

            function handleSort(column) {
                if (currentSort.column === column) {
                    // Inverser la direction si on clique sur la même colonne
                    currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
                } else {
                    // Nouvelle colonne, direction ascendante par défaut
                    currentSort = { column, direction: 'asc' };
                }
                
                updateSortIndicators();
                renderTable();
            }

            // ===== AJOUT AU GLOSSAIRE =====
            async function addIdentifierToGlossary(identifier) {
                if (!glossaryId) {
                    showError(
                        "No glossary selected. Please go back to a glossary first.",
                    );
                    return;
                }

                try {
                    const glossaries =
                        JSON.parse(localStorage.getItem("glossaries")) || [];
                    const glossaryIndex = glossaries.findIndex(
                        (g) => g.id === parseInt(glossaryId),
                    );

                    if (glossaryIndex === -1) {
                        showError("Glossary not found.");
                        return;
                    }

                    const glossary = glossaries[glossaryIndex];
                    const termExists = glossary.terms.some(
                        t => t.term.toLowerCase() === identifier.toLowerCase()
                    );

                    if (termExists) {
                        showMessage(`"${identifier}" is already in the glossary.`, "info");
                        // Mettre à jour l'affichage
                        displayAllIdentifiers();
                        return;
                    }

                    const nextId =
                        Math.max(...glossary.terms.map((t) => t.id), 0) + 1;

                    glossary.terms.push({
                        id: nextId,
                        term: identifier,
                        definition: `Extracted from code analysis (${selectedPath.split("/").pop()})`,
                        synonyms: [],
                    });

                    localStorage.setItem(
                        "glossaries",
                        JSON.stringify(glossaries),
                    );

                    loadGlossary();

                    showMessage(
                        `"${identifier}" added to glossary!`,
                        "success",
                    );

                    // Mettre à jour l'affichage
                    displayAllIdentifiers();
                    updateULCoverage();
                    updateULAlignment();
                } catch (error) {
                    showError(
                        `Failed to add identifier: ${error.message || error}`,
                    );
                }
            }

            // ===== GESTION DES MESSAGES =====
            function showMessage(message, type = "success") {
                const toast = document.createElement("div");
                toast.className = `fixed top-4 right-4 border rounded-lg shadow-lg p-4 z-50 transition-opacity duration-300 ${
                    type === "success"
                        ? "bg-green-100 border-green-400 text-green-700"
                        : type === "error"
                        ? "bg-red-100 border-red-400 text-red-700"
                        : "bg-blue-100 border-blue-400 text-blue-700"
                }`;

                toast.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="flex-1">
                            <p class="font-medium">${message}</p>
                        </div>
                        <button type="button" class="close-toast text-gray-500 hover:text-gray-700">
                            ×
                        </button>
                    </div>
                `;

                document.body.appendChild(toast);

                toast
                    .querySelector(".close-toast")
                    .addEventListener("click", () => {
                        toast.remove();
                    });

                setTimeout(() => {
                    if (toast.parentElement) {
                        toast.remove();
                    }
                }, 5000);
            }

            // ===== ÉCOUTEURS D'ÉVÉNEMENTS =====
            selectFileBtn.addEventListener("click", selectFile);
            selectFolderBtn.addEventListener("click", selectFolder);
            clearSelectionBtn.addEventListener("click", clearSelection);
            analyzeBtn.addEventListener("click", analyze);

            // Écouteurs pour les boutons de tri
            document.addEventListener('click', (event) => {
                const sortBtn = event.target.closest('.sort-btn');
                if (sortBtn) {
                    event.preventDefault();
                    const column = sortBtn.getAttribute('data-sort');
                    handleSort(column);
                }
            });

            // ===== INITIALISATION =====
            updateBackButton();
            updateSelectionDisplay();
        </script>
    </body>
</html>